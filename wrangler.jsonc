// Cloudflare-Konfiguration für das Vereinsheim (Hub + Werwolf + Spielegalerie +
// Tischtennis-Turnier in einem Projekt). Wird von Cloudflare beim Deploy
// automatisch gelesen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss mit dem Namen des Workers im Cloudflare-Dashboard übereinstimmen.
  "name": "vereinsheim",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",

  // Vor jedem Deploy (und bei "wrangler dev") wird die Werwolf-Oberfläche
  // gebaut – die beiden anderen Bereiche sind reines, unverändertes HTML/CSS/JS
  // und brauchen keinen Build-Schritt.
  "build": {
    "command": "npm run build",
    "watch_dir": ["clients/woelfe-src/src", "worker/src"]
  },

  // Alles, was hier NICHT auf "run_worker_first" passt, liefert Cloudflare
  // direkt als Datei aus client-assets/ aus, ohne den Worker überhaupt
  // aufzurufen (schnell und kostet kein Worker-Kontingent).
  "assets": {
    "directory": "./client-assets",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/tischtennis/t/*"]
  },

  // Ein Durable Object pro Werwolf-Spielraum bzw. pro Spielegalerie-Duell-Raum,
  // plus ein einzelnes, global adressiertes Objekt für die Spielegalerie-
  // Bestenlisten.
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "DUEL_ROOM", "class_name": "DuelRoom" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" }
    ]
  },
  // SQLite-basierte Durable Objects laufen auch im kostenlosen Workers-Plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "DuelRoom", "Leaderboard"] }
  ],

  // D1-Datenbank für das Tischtennis-Turnier. "database_id" muss nach dem
  // Anlegen der Datenbank eingetragen werden (siehe README, Schritt "Cloudflare
  // einrichten") – ohne das lehnt Cloudflare den Deploy ab.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vereinsheim-tischtennis",
      "database_id": "HIER-DIE-DATABASE-ID-AUS-WRANGLER-D1-CREATE-EINTRAGEN"
    }
  ],

  // Optional: fester Admin-Zugang fürs Tischtennis-Turnier statt eines beim
  // ersten Start zufällig erzeugten (und nur in den Worker-Logs sichtbaren)
  // Passworts. Siehe README.
  // "vars": { "ADMIN_USERNAME": "admin", "ADMIN_PASSWORD": "...", "SESSION_HOURS": "12" },

  "observability": { "enabled": true }
}
