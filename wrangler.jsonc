// Cloudflare-Konfiguration für das Vereinsheim (Hub + Werwolf + Quiz +
// Spielegalerie + Tischtennis-Turnier in einem Projekt). Wird von Cloudflare beim Deploy
// automatisch gelesen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss mit dem Namen des Workers im Cloudflare-Dashboard übereinstimmen.
  "name": "vereinsheim",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",

  // Vor jedem Deploy (und bei "wrangler dev") wird die Werwolf-Oberfläche
  // gebaut – die beiden anderen Bereiche sind reines, unverändertes HTML/CSS/JS
  // und brauchen keinen Build-Schritt.
  "build": {
    "command": "npm run build:woelfe",
    "watch_dir": ["clients/woelfe-src/src", "worker/src"]
  },

  // Geschlossene Gesellschaft: Jede Anfrage geht zuerst an den Worker, der den
  // Zugang prüft (worker/src/zugang/). Nur Schriften und Icons liefert
  // Cloudflare direkt aus – die verraten nichts und sparen Worker-Aufrufe.
  "assets": {
    "directory": "./client-assets",
    // Damit der Worker nach der Zugangsprüfung die Dateien selbst ausliefern kann.
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/shared/fonts/*", "!/shared/icons/*"]
  },

  // Ein Durable Object pro Werwolf-Spielraum, pro Spielegalerie-Duell-Raum,
  // pro laufendem Quiz und pro Gruppenspiel-Raum (Wer würde eher, Stadt-Land-Fluss), plus je ein einzelnes, global adressiertes Objekt für
  // die Spielegalerie-Bestenlisten und für Wordle.
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "DUEL_ROOM", "class_name": "DuelRoom" },
      { "name": "LEADERBOARD", "class_name": "Leaderboard" },
      { "name": "QUIZ_ROOM", "class_name": "QuizRoom" },
      { "name": "WORDLE", "class_name": "Wordle" },
      { "name": "PARTY_ROOM", "class_name": "PartyRoom" }
    ]
  },
  // SQLite-basierte Durable Objects laufen auch im kostenlosen Workers-Plan.
  // Wichtig: bestehende Einträge nie ändern, neue Klassen immer als neuen
  // Eintrag mit neuem "tag" hinten anhängen.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "DuelRoom", "Leaderboard"] },
    { "tag": "v2", "new_sqlite_classes": ["QuizRoom", "Wordle"] },
    { "tag": "v3", "new_sqlite_classes": ["PartyRoom"] }
  ],

  // D1-Datenbank für Konten, Quizze und das Tischtennis-Turnier.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vereinsheim-tischtennis",
      "database_id": "36e9a537-53ff-4785-84f5-459628678f8d"
    }
  ],

  // Wie lange ein Login gültig bleibt (Stunden). Passwörter gehören NICHT hierher
  // (die Datei ist öffentlich auf GitHub) – siehe README, "Erster Admin-Zugang".
  "vars": { "SESSION_HOURS": "12" },

  "observability": { "enabled": true }
}
