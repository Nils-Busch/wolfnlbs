// Cloudflare-Konfiguration für "Was für Wölfe".
// Wird von Cloudflare beim Deploy automatisch gelesen – hier muss normalerweise
// nichts angepasst werden.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss mit dem Namen des Workers im Cloudflare-Dashboard übereinstimmen.
  "name": "was-fuer-woelfe",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",

  // Vor jedem Deploy (und bei "wrangler dev") wird die React-App gebaut.
  "build": {
    "command": "npm run build",
    "watch_dir": ["client/src", "worker/src"]
  },

  // Die gebaute React-App wird als statische Seite ausgeliefert.
  // Nur /api/* geht an den Worker (Raum erstellen + WebSockets).
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Ein Durable Object pro Spielraum.
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  // SQLite-basierte Durable Objects laufen auch im kostenlosen Workers-Plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  "observability": { "enabled": true }
}
